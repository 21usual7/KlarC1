# Gemini is used when GEMINI_API_KEY is set; otherwise OpenAI.
GEMINI_API_KEY=
# Comma-separated; the next model is tried when one is overloaded.
GEMINI_MODEL=gemini-flash-latest,gemini-flash-lite-latest
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

CLOUDFLARE_API_TOKEN=

CLOUDFLARE_ACCOUNT_ID=

CLOUDFLARE_D1_DATABASE_ID=

RESEND_API_KEY=

EMAIL_FROM=

APP_ORIGIN=http://localhost:3000

# Server-only exemptions. The email must belong to a verified signed-in account.
AI_ADMIN_EMAILS=21usaul7@gmail.com
# Exact IPs of trusted reverse proxies; leave empty for direct connections.
# A proxy must append the real client address to X-Forwarded-For or overwrite it.
AI_TRUSTED_PROXY_IPS=
