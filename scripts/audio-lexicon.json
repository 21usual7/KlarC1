    [
      "\\b([a-z])\\(([a-z])\\)",
      "$1 von $2"
    ],
    [
      "([a-zA-Z0-9])²",
      "$1 Quadrat"
    ],
    [
      "([a-zA-Z0-9])³",
      "$1 hoch drei"
    ],
    [
      "√",
      "Wurzel aus "
    ],
    [
      "π",
      "Pi"
    ],
    [
      "≠",
      " ungleich "
    ],
    [
      "≤",
      " kleiner gleich "
    ],
    [
      "≥",
      " größer gleich "
    ],
    [
      "(\\d)\\s*%",
      "$1 Prozent"
    ],
    [
      "\\b([a-z]+)(\\d)(\\d)(\\d)\\b",
      "$1 $2 $3 $4"
    ],
    [
      "\\b([a-z]+)\\.([a-z]+)\\b",
      "$1 Punkt $2"
    ],
    [
      "(\\d{1,2}):0(\\d) Uhr",
      "$1 Uhr $2"
    ],
    [
      "(\\d{1,2}):(\\d{2}) Uhr",
      "$1 Uhr $2"
    ],
    [
      "q\\. e\\. d\\.",
      "Kuh Eh Deh"
    ]
  ],
